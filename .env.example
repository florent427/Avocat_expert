# Exemple de configuration locale — ne jamais y placer de secret réel.
AVX_ENVIRONMENT=local
AVX_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/avocat_expert
AVX_LEXVERIF_BIN=engine/target/debug/lexverif
# Empreinte SHA-256 du jeton de développement (printf %s "$JETON" | sha256sum)
AVX_DEV_TOKEN_SHA256=
# Application web (côté serveur uniquement)
AVX_API_URL=http://127.0.0.1:8000
AVX_API_TOKEN=
